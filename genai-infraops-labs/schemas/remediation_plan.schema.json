{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remediation plan proposed by the Resolver agent (never executed without human approval)",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket", "summary", "root_cause", "pre_checks", "command", "rollback",
               "verification", "blast_radius", "risk", "proposed_by"],
  "properties": {
    "ticket": {"type": "string", "pattern": "^INC[0-9]{7}$|^INC-MAJ-[0-9]{4}$"},
    "summary": {"type": "string", "maxLength": 200},
    "root_cause": {"type": "string", "maxLength": 400},
    "evidence_ref": {"type": "string"},
    "pre_checks": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "string"}}},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {"type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["command", "expect"],
        "properties": {"command": {"type": "array", "items": {"type": "string"}}, "expect": {"type": "string"}}}},
    "blast_radius": {"type": "string", "maxLength": 300},
    "risk": {"enum": ["Low", "Medium", "High"]},
    "proposed_by": {"type": "string"},
    "revision_of": {"type": ["string", "null"]}
  }
}
